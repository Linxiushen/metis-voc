# Copy configuration to .dev.vars for local Cloudflare development.
# Run pnpm setup:local to generate a local admin and settings encryption key.
# In production use wrangler secret put; see docs/DEPLOYMENT.md.
# Keep real values out of source control.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# KeepaMore free membership does not include API quota. Configure the km_ key
# created after purchasing an API package, or use the manual export importer.
KEEPAMORE_API_KEY=
KEEPAMORE_BASE_URL=https://mcp.keepamore.com/api

LOVART_ACCESS_KEY=
LOVART_SECRET_KEY=
LOVART_BASE_URL=https://lgw.lovart.ai
LOVART_PROXY_URL=
LOVART_PROXY_TOKEN=
LOVART_PROJECT_ID=
LOVART_IMAGE_MODEL=generate_image_gpt_image_2_high

# Generate 32 random bytes and encode them as unpadded base64url.
SETTINGS_ENCRYPTION_KEY=

# Emergency kill switch. Shared credentials require an eligible paid tenant.
# A tenant-owned KeepaMore key can be used only when this switch is true.
PAID_PROVIDER_CALLS_ENABLED=false
ENABLE_EXAMPLE_REPORTS=false
# Optional comma-separated exact HTTPS origins for separately hosted clients.
# The provided frontend always uses its own origin.
ALLOWED_API_ORIGINS=

# Optional one-time bootstrap for a brand-new database. Store the password hash
# as a secret. Bootstrap never resets or promotes an existing user; the entire
# installation must be empty. It can be configured after schema initialization.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD_HASH=
BOOTSTRAP_ADMIN_NAME=

{
  "name": "metis-voc",
  "version": "1.6.1",
  "description": "Evidence-aware cross-border product research and decision workspace",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm run build:vendor && vinext dev --hostname 127.0.0.1",
    "setup:local": "node scripts/setup-local.mjs",
    "test:smoke": "node scripts/smoke-local.mjs",
    "audit:source": "node scripts/audit-open-source.mjs",
    "cf:types": "wrangler types",
    "deploy": "node scripts/check-deploy.mjs && pnpm run build && wrangler deploy",
    "build": "vite build --config build/vite.metis-vendor.config.ts && vite build --config build/vite.metis-app.config.ts && vinext build",
    "build:client": "vite build --config build/vite.metis-app.config.ts",
    "build:vendor": "vite build --config build/vite.metis-vendor.config.ts",
    "start": "wrangler dev --local --ip 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "audit:reports": "node scripts/audit-reference-content.mjs --fail-on-fallback",
    "test:load": "node --test tests/api-decision-lifecycle.test.mjs && node scripts/load-baseline.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run audit:reports && pnpm run audit:source && pnpm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .codex-runtime",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "htm": "3.1.1",
    "next": "16.3.5",
    "preact": "10.29.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.10",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.0",
    "wrangler": "4.132.0"
  },
  "type": "module"
}
